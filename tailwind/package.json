{
  "name": "tailwind",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "node --max-old-space-size=2048 ./node_modules/.bin/tailwindcss -i ./input.css -o ../static/css/style.css --minify",
